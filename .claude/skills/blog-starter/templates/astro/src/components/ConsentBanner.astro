---
// Bannière de consentement (RGPD/ePrivacy) reliée à Google Consent Mode v2.
// NOTE : pour une conformité TCF complète (partenaires AdSense), un CMP certifié
// Google reste requis ; ce composant fournit le socle Consent Mode + le stockage du choix.
---
<div class="cookie-banner" id="cookieBanner" style="position:fixed;left:0;right:0;bottom:0;z-index:70;display:none">
  <div class="cb-text"><b>We use cookies.</b> To measure our audience and personalise advertising. You can accept, decline or manage your choices. See our <a href="/cookies" style="color:var(--volt)">Cookie Policy</a>.</div>
  <div class="cb-actions">
    <button class="btn btn-ghost btn-sm" onclick="location.href='/cookies'">Manage</button>
    <button class="btn btn-secondary btn-sm" id="cbDecline">Decline</button>
    <button class="btn btn-primary btn-sm" id="cbAccept">Accept</button>
  </div>
</div>
<script is:inline>
  (function () {
    var b = document.getElementById('cookieBanner');
    if (!b) return;
    function gtag(){ window.dataLayer = window.dataLayer || []; dataLayer.push(arguments); }
    if (!localStorage.getItem('rp-consent')) b.style.display = 'flex';
    function set(v) {
      gtag('consent', 'update', { ad_storage: v, analytics_storage: v, ad_user_data: v, ad_personalization: v });
      localStorage.setItem('rp-consent', v);
      b.style.display = 'none';
    }
    document.getElementById('cbAccept').addEventListener('click', function(){ set('granted'); });
    document.getElementById('cbDecline').addEventListener('click', function(){ set('denied'); });
  })();
</script>
