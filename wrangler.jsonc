{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-25",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "rigpure",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rigpure-db",
			"database_id": "a167cff1-0603-45a5-b5b8-434f16246621",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "56d8d84ea8aa4425b37dad30af569c5c"
		}
	],
	"vars": {
		"GTM_ID": "GTM-TLBBQ7MB"
	}
}
